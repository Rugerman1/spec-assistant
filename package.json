{
  "name": "spec-assistant",
  "version": "1.0.0",
  "private": true,
  "description": "Ask questions about the SCDOT Standard Specifications and get answers that cite the exact section.",
  "type": "module",
  "scripts": {
    "test": "vitest run",
    "typecheck": "tsc -p .",
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "extract": "python ingest/extract.py data/2025_SCDOT_Standard_Specifications.pdf",
    "load": "node scripts/load.mjs",
    "eval": "tsx eval/run-eval.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.132.1"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261008.1",
    "@types/node": "^26.6.4",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.3",
    "wrangler": "^4.148.0"
  }
}
